---
import { Database, ShieldCheck, Share2, Vote, Boxes, Lock } from '@lucide/astro';

const features = [
  {
    icon: Boxes,
    title: "Multi-Market Architecture",
    description: "Deploy independent lending markets. Borrowers manage reputation and collateral securely across isolated instances."
  },
  {
    icon: Share2,
    title: "Competitive Matching",
    description: "Lenders submit offers with varying APRs tracking dynamic interest rate discovery with seniority prioritization."
  },
  {
    icon: Database,
    title: "Collateral Escrow",
    description: "Chainlink oracle-based valuation with strictly monitored health thresholds to protect lent capital."
  },
  {
    icon: Vote,
    title: "Dutch Auction Liquidation",
    description: "Efficient collateral recovery via configurable step-based price reductions, providing transparent deficit recovery."
  },
  {
    icon: ShieldCheck,
    title: "On-Chain Reputation",
    description: "Borrowers earn scores from AAA to D. Penalties apply for defaults while successful loans yield increased trust."
  },
  {
    icon: Lock,
    title: "Position NFTs",
    description: "Lender positions are minted as transferable ERC721 tokens encoding principal, interest variables, and seniority."
  }
];
---

<section id="features" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold mb-4">
        Protocol <span class="text-primary">Highlights</span>
      </h2>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Designed for capital efficiency and cross-chain financial innovation.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="glass p-8 rounded-2xl hover:border-primary/50 transition-all group">
          <div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
            <feature.icon class="w-6 h-6 text-primary" />
          </div>
          <h3 class="text-xl font-bold mb-3">{feature.title}</h3>
          <p class="text-muted-foreground leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>