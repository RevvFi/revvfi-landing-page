---
import { ShieldCheck } from '@lucide/astro';

const stats = [
  { label: "MAJOR AUDITS", value: "3+" },
  { label: "BUG BOUNTY", value: "$5M" },
  { label: "MONITORING", value: "24/7" },
  { label: "TO FLASHLOANS", value: "Immune" }
];
---

<section id="security" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/20 mb-8">
      <ShieldCheck class="w-8 h-8 text-primary" />
    </div>
    
    <h2 class="text-4xl md:text-5xl font-bold mb-16">
      Uncompromising <span class="text-primary">Security</span>
    </h2>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 mb-20">
      {stats.map((stat) => (
        <div class="flex flex-col items-center">
          <div class="text-3xl md:text-4xl font-bold mb-2">{stat.value}</div>
          <div class="text-xs font-bold text-muted-foreground uppercase tracking-widest">{stat.label}</div>
        </div>
      ))}
    </div>

    <div class="max-w-4xl mx-auto glass p-8 md:p-12 rounded-3xl relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary/10 blur-[100px] -z-10"></div>
      
      <blockquote class="text-xl md:text-2xl italic text-white/90 leading-relaxed mb-8">
        "RevvFi represents the new standard in smart contract robustness. Their modular approach to security and constant monitoring makes it the safest environment for large-scale capital deployment in the ecosystem today."
      </blockquote>
      
      <div class="flex items-center justify-center gap-4">
        <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center">
          <div class="w-10 h-10 bg-muted rounded-full"></div>
        </div>
        <div class="text-left">
          <div class="font-bold">Lead Security Researcher</div>
          <div class="text-primary text-xs font-bold uppercase tracking-wider">CERTIFIED PARTNER</div>
        </div>
      </div>
    </div>
  </div>
</section>