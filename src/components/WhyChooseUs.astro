---
import { Shield, Lock, Users, Layers, Clock, Building2 } from '@lucide/astro';

const reasons = [
  {
    icon: Shield,
    title: "Oracle Security",
    description: "Robust Chainlink integrations value collateral instantly with 2-hour staleness safeguards."
  },
  {
    icon: Lock,
    title: "Epoch Liquidity",
    description: "7-day epoch withdrawal cycles prevent flash bank runs ensuring systemic liquidity stability."
  },
  {
    icon: Users,
    title: "Peer-to-Peer Focus",
    description: "Fully decentralized structure allowing open participant alignment bypassing legacy intermediaries."
  },
  {
    icon: Layers,
    title: "Per-Market Segregation",
    description: "Isolate risks exclusively to individual borrower structures providing transparent, granular risk assignment."
  },
  {
    icon: Clock,
    title: "Dutch Liquidations",
    description: "Continuous variable auction decreasing 5% per hour to ensure maximum collateral extraction over forced dumps."
  },
  {
    icon: Building2,
    title: "Tiered Seniority",
    description: "Separate Senior vs. Junior lending tiers for optimized risk/reward ratios tailored to provider profiles."
  }
];
---

<section id="why-choose-us" class="py-24 relative overflow-hidden bg-black">

    <!-- Background Image restricted to this section -->
  <div class="absolute inset-0 z-0">
    <img
      src="/why_choose_revvfi.webp"
      alt="Why Choose RevvFi Background"
      class="w-full h-full object-cover opacity-10 mix-blend-overlay"
    />
    <div class="absolute inset-0 bg-linear-to-b from-black via-transparent to-black"></div>
  </div>

  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-200 h-200 bg-primary/5 blur-[120px] rounded-full -z-10"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/10 bg-white/5 text-xs font-bold uppercase tracking-widest mb-8">
      <span class="text-primary"></span> WHY REVVFI?
    </div>
    
    <h2 class="text-4xl md:text-6xl font-bold mb-6">
      Why Choose <span class="text-primary">RevvFi?</span>
    </h2>
    
    <p class="text-muted-foreground text-lg md:text-xl max-w-3xl mx-auto mb-16 leading-relaxed">
      A lending protocol designed with capital protection, transparent terms, and isolated execution.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-left">
      {reasons.map((reason) => (
        <div class="group relative p-8 rounded-4xl border border-white/5 bg-secondary hover:border-primary/30 transition-all duration-500">
          <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center mb-8 border border-primary/20 group-hover:bg-primary/20 transition-colors">
            <reason.icon class="w-7 h-7 text-primary" />
          </div>
          
          <h3 class="text-2xl font-bold mb-4">{reason.title}</h3>
          
          <div class="w-10 h-0.5 bg-primary/40 mb-6 group-hover:w-16 transition-all duration-300"></div>
          
          <p class="text-muted-foreground leading-relaxed">
            {reason.description}
          </p>
          
          <!-- Subtle bottom glow on hover -->
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-px bg-primary/50 group-hover:w-1/2 transition-all duration-500 blur-sm"></div>
        </div>
      ))}
    </div>
  </div>
</section>