---
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
  <!-- Background Image Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/Hero_background.webp" 
      alt="Hero Background" 
      class="w-full h-full object-cover opacity-60"
    />
    <div class="absolute inset-0 bg-linear-to-b from-black/20 via-black/40 to-black"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
        </span>
        Dynamic Peer-to-Peer Lending
      </div>
      
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 leading-tight">
        Sophisticated <br />
        <span class="text-gradient">Decentralized <br /> Lending Protocol</span>
      </h1>
      
      <p class="text-lg md:text-xl text-muted-foreground mb-10 max-w-2xl leading-relaxed">
        Facilitating peer-to-peer lending with dynamic interest rate discovery, competitive offer mechanisms, and flexible market creation.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="http://app.revvfi.xyz/" class="bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-xl font-bold transition-all transform hover:scale-105 text-center">
          Launch App
        </a>
        <a href="http://docs.revvfi.xyz/" class="glass hover:bg-white/5 text-white px-8 py-4 rounded-xl font-bold transition-all text-center">
          Read Documentation
        </a>
      </div>
    </div>
  </div>
</section>