---
import { ArrowUpRight } from '@lucide/astro';
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-white">
  <!-- Background: soft cloud photo fading to white, matching the reference's light-theme hero -->
  <div class="absolute inset-0 z-0">
    <img
      src="/revvfi-landing-hero.png"
      alt="Hero Background"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-linear-to-b from-transparent via-white/40 to-white"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
    <div class="max-w-3xl mx-auto text-center">
      <div class="hero-badge inline-flex items-center gap-2.5 text-primary text-xs font-bold uppercase tracking-widest mb-6">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        Dynamic Peer-to-Peer Lending
      </div>

      <h1 class="font-serif text-5xl md:text-7xl font-semibold tracking-tight mb-6 leading-[1.1] text-foreground">
        Sophisticated <br />
        Decentralized <br /> Lending Protocol
      </h1>

      <p class="text-lg md:text-xl text-muted-foreground mb-10 max-w-2xl mx-auto leading-relaxed">
        Facilitating peer-to-peer lending with dynamic interest rate discovery, competitive offer mechanisms, and flexible market creation.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="http://app.revvfi.xyz/" class="inline-flex items-center justify-center gap-3 bg-black hover:bg-black/90 text-white pl-8 py-2 pr-2 rounded-full font-bold transition-all transform hover:scale-105">
          Launch App
          <span class="bg-primary rounded-full p-2.5 flex items-center justify-center">
            <ArrowUpRight class="w-4 h-4 text-white" />
          </span>
        </a>
        <a href="http://docs.revvfi.xyz/" class="border border-black/15 hover:bg-black/5 text-foreground px-8 py-4 rounded-full font-bold transition-all text-center">
          Read Documentation
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // The entrance `animation`'s fill-mode keeps holding `transform` after it
  // finishes, which otherwise wins the cascade over :hover's transition on
  // that same property. Clearing it once done lets the badge fall back to
  // plain CSS (transform: none, opacity/filter already at their rest values
  // from the animation's last frame) so hover can freely animate transform.
  document.querySelectorAll<HTMLElement>('.hero-badge').forEach((el) => {
    el.addEventListener('animationend', () => { el.style.animation = 'none'; }, { once: true });
  });
</script>

<style>
  .hero-badge {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 106, 26, 0.18);
    border-radius: 999px;
    padding: 10px 22px;
    box-shadow:
      0 10px 35px rgba(0, 0, 0, 0.08),
      0 2px 8px rgba(255, 106, 26, 0.08);
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    animation: hero-badge-in 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-badge:hover {
    transform: translateY(-2px);
    box-shadow:
      0 14px 40px rgba(0, 0, 0, 0.1),
      0 4px 12px rgba(255, 106, 26, 0.14);
    border-color: rgba(255, 106, 26, 0.32);
  }
  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    background: linear-gradient(135deg, #ff7a1a, #ff9a3c);
    box-shadow: 0 0 10px rgba(255, 122, 26, 0.45);
  }
  @keyframes hero-badge-in {
    from {
      opacity: 0;
      transform: translateY(10px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }
</style>
