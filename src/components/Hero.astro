---
import { ArrowUpRight } from '@lucide/astro';
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-white">
  <!-- Background: soft cloud photo fading to white, matching the reference's light-theme hero -->
  <div class="absolute inset-0 z-0">
    <img
      src="/revvfi-landing-hero.png"
      alt="Hero Background"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-linear-to-b from-transparent via-white/40 to-white"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
        </span>
        Dynamic Peer-to-Peer Lending
      </div>

      <h1 class="font-serif text-5xl md:text-7xl font-semibold tracking-tight mb-6 leading-[1.1] text-foreground">
        Sophisticated <br />
        Decentralized <br /> Lending Protocol
      </h1>

      <p class="text-lg md:text-xl text-muted-foreground mb-10 max-w-2xl leading-relaxed">
        Facilitating peer-to-peer lending with dynamic interest rate discovery, competitive offer mechanisms, and flexible market creation.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="http://app.revvfi.xyz/" class="inline-flex items-center justify-center gap-3 bg-black hover:bg-black/90 text-white pl-8 py-2 pr-2 rounded-full font-bold transition-all transform hover:scale-105">
          Launch App
          <span class="bg-primary rounded-full p-2.5 flex items-center justify-center">
            <ArrowUpRight class="w-4 h-4 text-white" />
          </span>
        </a>
        <a href="http://docs.revvfi.xyz/" class="border border-black/15 hover:bg-black/5 text-foreground px-8 py-4 rounded-full font-bold transition-all text-center">
          Read Documentation
        </a>
      </div>
    </div>
  </div>
</section>
