---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="pt-40 pb-16 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
	<div class="absolute top-0 left-1/2 -translate-x-1/2 w-200 h-96 bg-primary/5 blur-[120px] rounded-full -z-10"></div>
	<div class="max-w-4xl mx-auto">
		<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-6">
			{eyebrow}
		</div>
		<h1 class="font-serif text-4xl md:text-6xl font-semibold tracking-tight mb-6 leading-tight">{title}</h1>
		{description && (
			<p class="text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed">{description}</p>
		)}
	</div>
</section>
