---
import { X, Disc as Discord, ArrowUpRight } from '@lucide/astro';
---

<footer class="bg-white pt-24 pb-12 border-t border-black/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- CTA banner: dark card with subtle grid texture, matching the reference -->
    <div class="relative overflow-hidden rounded-3xl bg-black px-8 py-16 sm:px-16 sm:py-20 mb-20 text-center">
      <!-- Subtle grid pattern -->
      <div
        class="absolute inset-0 opacity-[0.07]"
        style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 64px 64px;"
      ></div>
      <div class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-black/60"></div>

      <h2 class="relative font-serif text-3xl sm:text-5xl font-medium tracking-tight text-white leading-tight max-w-3xl mx-auto">
        Start lending or borrowing
        <a
          href="http://app.revvfi.xyz/"
          class="inline-flex items-center gap-2 align-middle mx-2 bg-white hover:bg-white/90 text-black pl-5 py-1.5 pr-1.5 rounded-full text-xl sm:text-2xl font-sans font-bold transition-all"
        >
          Launch App
          <span class="bg-primary rounded-full p-2 flex items-center justify-center">
            <ArrowUpRight class="w-4 h-4 text-white" />
          </span>
        </a>
        in minutes
      </h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-8 mb-16">
      <div class="col-span-2 lg:col-span-2">
        <div class="flex items-center gap-2 mb-6">
          <img src="/favicon.svg" alt="RevvFi Logo" class="h-13 w-13" />
          <span class="text-2xl font-extrabold tracking-tighter">RevvFi</span>
        </div>
        <p class="text-muted-foreground max-w-xs mb-8">
          Level Up Your Trading Experience with institutional grade liquidity infrastructure.
        </p>
        <a
          href="http://app.revvfi.xyz/"
          class="inline-flex items-center gap-2 bg-black hover:bg-black/90 text-white pl-5 py-1.5 pr-1.5 rounded-full text-sm font-bold transition-all mb-8"
        >
          Get started
          <span class="bg-primary rounded-full p-1.5 flex items-center justify-center">
            <ArrowUpRight class="w-3.5 h-3.5 text-white" />
          </span>
        </a>
        <div class="flex gap-4">
          <a href="https://twitter.com/revvfi_xyz" class="w-10 h-10 glass rounded-full flex items-center justify-center hover:text-primary transition-colors">
            <X class="w-5 h-5" />
          </a>
          <a href="https://discord.gg/KJ3ttJq5D3" class="w-10 h-10 glass rounded-full flex items-center justify-center hover:text-primary transition-colors">
            <Discord class="w-5 h-5" />
          </a>
          <a href="https://github.com/RevvFi" class="w-10 h-10 glass rounded-full flex items-center justify-center hover:text-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-bold mb-6 uppercase text-xs tracking-widest text-muted-foreground">Company</h4>
        <ul class="space-y-4 text-sm">
          <li><a href="/about" class="group inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">About <ArrowUpRight class="w-3 h-3 text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></a></li>
          <li><a href="/team" class="group inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">Team <ArrowUpRight class="w-3 h-3 text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></a></li>
          <li><a href="/invest" class="group inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">Invest <ArrowUpRight class="w-3 h-3 text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></a></li>
          <li><a href="/contribute" class="group inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">Contribute <ArrowUpRight class="w-3 h-3 text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold mb-6 uppercase text-xs tracking-widest text-muted-foreground">Resources</h4>
        <ul class="space-y-4 text-sm">
          <li><a href="http://docs.revvfi.xyz/" class="group inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">Documentation <ArrowUpRight class="w-3 h-3 text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></a></li>
          <li><a href="http://app.revvfi.xyz/" class="group inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">Launch App <ArrowUpRight class="w-3 h-3 text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></a></li>
          <li><a href="https://github.com/RevvFi" class="group inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">GitHub <ArrowUpRight class="w-3 h-3 text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold mb-6 uppercase text-xs tracking-widest text-muted-foreground">Contact</h4>
        <ul class="space-y-4 text-sm">
          <li><a href="/contact" class="group inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">Get in Touch <ArrowUpRight class="w-3 h-3 text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></a></li>
          <li><a href="/terms" class="group inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">Terms <ArrowUpRight class="w-3 h-3 text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></a></li>
          <li><a href="/privacy" class="group inline-flex items-center gap-1 text-muted-foreground hover:text-foreground transition-colors">Privacy <ArrowUpRight class="w-3 h-3 text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" /></a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-black/5 flex flex-col md:flex-row justify-between gap-4 text-xs text-muted-foreground font-medium uppercase tracking-widest">
      <p>© {new Date().getFullYear()} REVVFI PROTOCOL. ALL RIGHTS RESERVED.</p>
      <div class="flex gap-8">
        <a href="/privacy" class="hover:text-foreground transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-foreground transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
