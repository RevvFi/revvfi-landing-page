---
import { ShieldAlert } from '@lucide/astro';

const guarantees = [
  "Full refund if funding fails",
  "No creator custody of funds",
  "Locked liquidity until maturity",
  "No upgradeable launch contracts"
];
---

<section id="safety" class="py-24 relative overflow-hidden bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass rounded-[2.5rem] p-8 md:p-12 relative overflow-hidden border border-white/10 group">
      <!-- Glow effect -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-primary/10 blur-[100px] -z-10 group-hover:bg-primary/20 transition-all duration-500"></div>
      
      <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
        <div class="flex flex-col md:flex-row items-center gap-8 text-center md:text-left lg:w-1/2">
          <div class="relative">
            <div class="absolute inset-0 bg-primary/40 blur-2xl rounded-full opacity-50 group-hover:opacity-80 transition-opacity"></div>
            <div class="relative w-24 h-24 rounded-3xl bg-primary/20 flex items-center justify-center border border-primary/30">
              <ShieldAlert class="w-12 h-12 text-primary" />
            </div>
          </div>
          
          <div>
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Safety Guarantees</h2>
            <p class="text-muted-foreground text-lg leading-relaxed">
              Deterministic protocol protections enforced by immutable smart contracts for all participants.
            </p>
          </div>
        </div>

        <!-- Divider for desktop -->
        <div class="hidden lg:block w-px h-32 bg-white/10"></div>
        
        <div class="lg:w-2/5 w-full">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6">
            {guarantees.map((item) => (
              <div class="flex items-center gap-4 group/item">
                <div class="w-2 h-2 rounded-full bg-primary shadow-[0_0_10px_rgba(168,85,247,0.5)]"></div>
                <span class="text-sm md:text-base font-semibold text-white/90 group-hover/item:text-primary transition-colors">
                  {item}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>