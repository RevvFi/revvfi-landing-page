---
import { Menu, X, ArrowUpRight } from '@lucide/astro';

const links = [
	{ href: '/#faq', label: 'FAQ', section: 'faq' },
	{ href: '/#why-choose-us', label: 'Why RevvFi', section: 'why-choose-us' },
	{ href: '/#workflow', label: 'Lifecycle', section: 'workflow' },
	{ href: '/#safety', label: 'Safety', section: 'safety' },
	{ href: '/about', label: 'About' },
	{ href: '/team', label: 'Team' },
	{ href: 'https://docs.revvfi.xyz/', label: 'Docs' },
];

---

<!-- "Dynamic island" style floating pill navbar: dark, rounded-full, margin from the
     viewport edges. Collapses to an icon + current-section label once you've
     scrolled past the hero, expands back to the full nav at the top of the page. -->
<nav id="site-nav" class="fixed top-4 sm:top-6 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-2rem)] max-w-5xl">
	<div id="nav-pill" class="w-full flex justify-center items-center bg-black/95 backdrop-blur-md rounded-full shadow-lg shadow-black/20 pl-5 pr-2 py-2 transition-all duration-300 mx-auto">
		<!-- Full nav content -->
		<div id="nav-full" class="flex justify-between items-center gap-4 w-full">
			<a href="/" class="flex items-center gap-2 shrink-0">
				<img src="/favicon.svg" alt="RevvFi Logo" class="h-8 w-8" />
				<span class="text-lg font-bold tracking-tight text-white">RevvFi</span>
			</a>

			<div class="hidden lg:flex items-center gap-6">
				{links.map((l) => (
					<a href={l.href} data-section={l.section} class="nav-link text-sm font-medium text-white/60 hover:text-white transition-colors whitespace-nowrap">{l.label}</a>
				))}
			</div>

			<a href="http://app.revvfi.xyz/" class="hidden sm:inline-flex shrink-0 items-center gap-2 bg-white hover:bg-white/90 text-black pl-4 py-1.5 pr-1.5 rounded-full text-sm font-bold transition-colors">
				Launch App
				<span class="bg-primary rounded-full p-1.5 flex items-center justify-center">
					<ArrowUpRight class="w-3.5 h-3.5 text-white" />
				</span>
			</a>

			<button
				id="mobile-menu-button"
				aria-label="Toggle navigation"
				class="lg:hidden flex items-center justify-center h-9 w-9 text-white shrink-0"
			>
				<Menu id="menu-icon" class="h-6 w-6" />
				<X id="close-icon" class="h-6 w-6 hidden" />
			</button>
		</div>

		<!-- Collapsed "island" content: icon + current section label + live dot -->
		<a
			id="nav-collapsed"
			href="/"
			class="hidden items-center gap-3 px-3"
		>
			<img src="/favicon.svg" alt="RevvFi Logo" class="h-6 w-6" />
			<span id="nav-current-section" class="text-sm font-semibold text-white">Overview</span>
			<span class="relative flex h-2.5 w-2.5">
				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
				<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary"></span>
			</span>
		</a>
	</div>

	<div id="mobile-menu" class="hidden lg:hidden mt-2 bg-black/95 backdrop-blur-md rounded-3xl shadow-lg shadow-black/20">
		<div class="px-4 py-4 flex flex-col gap-1">
			{links.map((l) => (
				<a href={l.href} class="py-3 text-sm font-medium text-white/60 hover:text-white transition-colors">{l.label}</a>
			))}
			<a href="http://app.revvfi.xyz/" class="mt-2 inline-flex items-center justify-center gap-2 bg-white hover:bg-white/90 text-black pl-5 py-1.5 pr-1.5 rounded-full text-sm font-bold text-center transition-colors">
				Launch App
				<span class="bg-primary rounded-full p-1.5 flex items-center justify-center">
					<ArrowUpRight class="w-3.5 h-3.5 text-white" />
				</span>
			</a>
		</div>
	</div>
</nav>

<script>
	const button = document.getElementById('mobile-menu-button');
	const menu = document.getElementById('mobile-menu');
	const menuIcon = document.getElementById('menu-icon');
	const closeIcon = document.getElementById('close-icon');

	button?.addEventListener('click', () => {
		menu?.classList.toggle('hidden');
		menuIcon?.classList.toggle('hidden');
		closeIcon?.classList.toggle('hidden');
	});

	// "Dynamic island" collapse: once scrolled past the hero, shrink the pill
	// down to icon + current-section label; expand back to the full nav at
	// the top of the page.
	const navPill = document.getElementById('nav-pill');
	const navFull = document.getElementById('nav-full');
	const navCollapsed = document.getElementById('nav-collapsed');
	const currentSectionLabel = document.getElementById('nav-current-section');

	const trackedSections = [
		{ id: 'faq', label: 'FAQ' },
		{ id: 'why-choose-us', label: 'Why RevvFi' },
		{ id: 'workflow', label: 'Lifecycle' },
		{ id: 'safety', label: 'Safety' },
	]
		.map((s) => ({ ...s, el: document.getElementById(s.id) }))
		.filter((s) => s.el);

	const COLLAPSE_THRESHOLD = 120;

	function setCollapsed(collapsed: boolean) {
		if (!navFull || !navCollapsed || !navPill) return;
		if (collapsed) {
			navFull.classList.add('hidden');
			navCollapsed.classList.remove('hidden');
			navCollapsed.classList.add('flex');
			navPill.classList.remove('w-full');
			navPill.classList.add('w-fit');
		} else {
			navFull.classList.remove('hidden');
			navCollapsed.classList.add('hidden');
			navCollapsed.classList.remove('flex');
			navPill.classList.add('w-full');
			navPill.classList.remove('w-fit');
		}
	}

	function updateCurrentSection() {
		const triggerLine = window.innerHeight * 0.35;
		let active: string | null = null;
		for (const s of trackedSections) {
			const rect = s.el!.getBoundingClientRect();
			if (rect.top <= triggerLine) {
				active = s.label;
			}
		}
		if (active && currentSectionLabel) {
			currentSectionLabel.textContent = active;
		}
	}

	let ticking = false;
	function onScroll() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			const collapsed = window.scrollY > COLLAPSE_THRESHOLD;
			setCollapsed(collapsed);
			if (collapsed) updateCurrentSection();
			ticking = false;
		});
	}

	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>
