---
const steps = [
  {
    num: "01",
    title: "Launch Creation",
    description: "Creator initializes a new launch via RevvFiFactory with predefined parameters and a fixed launch fee."
  },
  {
    num: "02",
    title: "ETH Deposits",
    description: "Liquidity providers deposit ETH and receive non-transferable shares representing ownership and governance power."
  },
  {
    num: "03",
    title: "Funding Outcome",
    description: "If the target is reached, liquidity is deployed. If not, LPs can claim full refunds after the raise window ends."
  },
  {
    num: "04",
    title: "Liquidity Deployment",
    description: "ETH and token allocation are paired and deployed to a dedicated Uniswap V2 pool. LP tokens are held by the protocol."
  },
  {
    num: "05",
    title: "Lock Period",
    description: "Funds remain locked until maturityTime, defined as raiseEndTime plus lockDuration."
  },
  {
    num: "06",
    title: "Withdrawal",
    description: "After maturity, LPs can burn shares to withdraw assets or convert their position entirely into ETH."
  }
];
---

<section id="workflow" class="py-24 bg-muted/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-16">
      <div class="lg:w-1/3">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          Launch <br />
          <span class="text-primary">Lifecycle</span>
        </h2>
        <p class="text-muted-foreground text-lg mb-8">
          A deterministic flow governing capital from deposit to withdrawal.
        </p>
        
        <div class="glass p-6 rounded-2xl border-l-4 border-primary">
          <div class="font-bold text-primary mb-1 uppercase tracking-wider text-sm">Modular System</div>
          <p class="text-sm text-muted-foreground">BUILT FOR EXTENSIBILITY</p>
        </div>
      </div>

      <div class="lg:w-2/3 grid gap-4">
        {steps.map((step) => (
          <div class="glass p-6 rounded-xl flex items-center gap-8 group hover:bg-white/10 transition-colors">
            <span class="text-3xl font-black text-white/10 group-hover:text-primary/40 transition-colors">{step.num}</span>
            <div>
              <h3 class="text-lg font-bold mb-1">{step.title}</h3>
              <p class="text-muted-foreground text-sm">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>