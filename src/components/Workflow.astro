---
const steps = [
  {
    num: "01",
    title: "Market Deployment",
    description: "Borrowers deploy independent markets via the Factory, setting collateral ratios and thresholds."
  },
  {
    num: "02",
    title: "Offer Submission",
    description: "Lenders provide liquidity by submitting competitive offers setting custom terms, durations, and APR limits."
  },
  {
    num: "03",
    title: "Collateral Escrow",
    description: "Borrowers seamlessly deposit oracle-monitored collateral into isolated vault contracts."
  },
  {
    num: "04",
    title: "Matching & Borrowing",
    description: "The protocol matches borrower requests favoring the lowest-rate, highest-seniority lending offers automatically."
  },
  {
    num: "05",
    title: "Interest Accrual",
    description: "Continuous synchronization compounding interest relative to specific borrowed volumes over elapsed durations."
  },
  {
    num: "06",
    title: "Repayment & Liquidity Queue",
    description: "Repayments augment borrower credibility. Lenders reclaim positions via 7-day Epoch distributions."
  }
];
---

<section id="workflow" class="py-24 bg-muted/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-16">
      <div class="lg:w-1/3">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
          Complete <br />
          <span class="text-primary">Lending Cycle</span>
        </h2>
        <p class="text-muted-foreground text-lg mb-8">
          A deterministic flow executing capital deployment from market creation to final withdrawal logic.
        </p>
        
        <div class="glass p-6 rounded-2xl border-l-4 border-primary">
          <div class="font-bold text-primary mb-1 uppercase tracking-wider text-sm">Modular System</div>
          <p class="text-sm text-muted-foreground">BUILT FOR EXTENSIBILITY</p>
        </div>
      </div>

      <div class="lg:w-2/3 grid gap-4">
        {steps.map((step) => (
          <div class="glass p-6 rounded-xl flex items-center gap-8 group hover:bg-white/10 transition-colors">
            <span class="text-3xl font-black text-white/10 group-hover:text-primary/40 transition-colors">{step.num}</span>
            <div>
              <h3 class="text-lg font-bold mb-1">{step.title}</h3>
              <p class="text-muted-foreground text-sm">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>