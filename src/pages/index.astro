---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Workflow from '../components/Workflow.astro';
import Safety from '../components/Safety.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="RevvFi | Fixed-Rate Institutional Lending Protocol"
	description="RevvFi is a fixed-rate, peer-to-peer lending protocol with isolated markets, Chainlink-priced collateral, Dutch-auction liquidations, and on-chain borrower reputation."
>
	<Navbar />
	<main>
		<Hero />
		<Features />
		<WhyChooseUs />
		<Workflow />
		<Safety />
		<CTA />
	</main>
	<Footer />
</Layout>
